{
  "name": "@synadiaorbit/counters",
  "version": "1.1.0",
  "files": [
    "lib/",
    "LICENSE",
    "README.md"
  ],
  "types": "./lib/mod.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/esm/mod.d.ts",
        "default": "./lib/esm/mod.js"
      },
      "require": {
        "types": "./lib/mod.d.ts",
        "default": "./lib/mod.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synadia-io/orbit.js.git"
  },
  "private": false,
  "engines": {
    "node": ">= 22"
  },
  "scripts": {
    "real-clean": "npm run clean && shx rm -Rf ./node_modules",
    "clean": "shx rm -Rf ./lib",
    "build-cjs": "npm run clean && tsc",
    "build-esm": "tsc -p tsconfig.esm.json && node -e \"require('fs').writeFileSync('lib/esm/package.json', JSON.stringify({type: 'module', sideEffects: false}) + '\\n')\"",
    "build": "npm run build-cjs && npm run build-esm",
    "prepack": "npm run build",
    "bump-qualifier": "npm version prerelease --no-commit-hooks --no-git-tag-version",
    "bump-release": "npm version patch --no-commit-hooks --no-git-tag-version"
  },
  "keywords": [],
  "author": {
    "name": "Synadia Communications, Inc."
  },
  "description": "jetstream counter streams",
  "dependencies": {
    "@nats-io/nats-core": "3.5.0",
    "@nats-io/jetstream": "3.5.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "shx": "^0.4.0",
    "typescript": "^5.9.3"
  }
}
